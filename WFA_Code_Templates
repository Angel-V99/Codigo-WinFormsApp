//Ocultar una ventana y abrir otra
private void ContinueToPageButton_Click(object sender, EventArgs e)
{
    FormNuevo menu = new FormNuevo();
    menu.FormClosed += (s, args) => Application.Exit();
    menu.Show();
    this.Hide();
}

